{
  "name": "basic-store",
  "private": true,
  "version": "2.0.0",
  "description": "Basic Store — online shop with delivery, stock and order management (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @trs/web",
    "dev:api": "npm run dev -w @trs/api",
    "build": "npm run build -w @trs/shared --if-present && npm run build -w @trs/api && npm run build -w @trs/web",
    "build:web": "npm run build -w @trs/web",
    "build:api": "npm run build -w @trs/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "source-map-js": "^1.2.2"
  }
}
